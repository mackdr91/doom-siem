# Author: Domonick Mack
# Date: 2026-11-16
# Description: Git ignore rules for Doom SIEM monorepo (Go, Next.js, Docker, and macOS).

# Operating System
.DS_Store
Thumbs.db

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Go Backend
backend/bin/
backend/dist/
backend/coverage.out
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Next.js Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/next-env.d.ts
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Docker Volumes & Local Data
.data/
volumes/
tmp/

# IDE & Editor Directories
.idea/
.vscode/
*.swp
*.swo
