# Author: Domonick Mack
# Date: 2026-11-16
# Description: Example environment variables for the Doom SIEM local Docker Compose and Railway environment.

# --- Application Environment ---
DOOM_ENV=development
DOOM_VERSION=0.1.0-phase1

# --- Go Ingestion & Detection Engine ---
BACKEND_PORT=8080
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_PORT=5514
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3000

# --- PostgreSQL (Relational Store for Alerts, Incidents & MITRE Rules) ---
POSTGRES_USER=doom_admin
POSTGRES_PASSWORD=doom_secret_pass
POSTGRES_DB=doom_siem
POSTGRES_HOST=postgres
POSTGRES_PORT=5434
POSTGRES_DSN=postgres://doom_admin:doom_secret_pass@postgres:5432/doom_siem?sslmode=disable

# --- ClickHouse (Columnar OLAP Store for Log & Telemetry Streams) ---
CLICKHOUSE_USER=doom_ch
CLICKHOUSE_PASSWORD=doom_ch_secret
CLICKHOUSE_DB=doom_telemetry
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_HTTP_URL=http://clickhouse:8123

# --- Redis (Event Streaming & Real-Time Pub/Sub) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_ADDR=redis:6379

# --- AI Threat Analysis (Optional in Phase 1, used in Phase 4) ---
GEMINI_API_KEY=

# --- Next.js SOC Dashboard ---
FRONTEND_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:8080
INTERNAL_API_URL=http://backend:8080
